# Generate secure random secrets locally; never commit your real .env
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
POSTGRES_DB=media45
POSTGRES_USER=media45
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MEDIA45_HOST=media.example.org
MEDIA45_ORIGIN=https://media.example.org
# Optional scanner/scheduler overlays: paths on YOUR Docker host, never in the Git repository.
# Set these to your own NAS mount points in your private .env before enabling scanning.
MEDIA45_MOVIES_PATH=/srv/media/movies
MEDIA45_SERIES_PATH=/srv/media/series
# TMDB identifies films and series and supplies their posters.
# TMDB read access token (Bearer), for film/series metadata and posters.
# Enter the real secret ONLY in the local .env file, never in GitHub.
TMDB_READ_ACCESS_TOKEN=

# Gotify Application token (not a user/client token). HTTPS URL only.
GOTIFY_URL=
GOTIFY_TOKEN=
